# Root .gitignore for E-Commerce Project

# Environment files
.env
.env.local
*.env

# Database credentials
**/application-local.properties
**/application-secret.properties

# Temporary files created during development
CleanDuplicates.java
clean_duplicates.ps1
remove_duplicate_products.sql

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS files
.DS_Store
Thumbs.db

# Build outputs
target/
dist/
build/
*.jar
*.war

# Dependencies
node_modules/

# Logs
*.log
logs/

# Compiled files
*.class
*.pyc

# Personal notes (if any)
**/notes/
**/personal/
