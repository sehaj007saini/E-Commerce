# Root .gitignore for E-Commerce Project

# Environment files
.env
.env.local
*.env

# Database credentials
**/application-local.properties
**/application-secret.properties

# Personal/Academic files
SUMMER_TRAINING_REPORT.md
REPORT_GENERATION_COMPLETE.md
*_TRAINING_REPORT.md
**/Project-Report-*.docx
**/*_Singh_*.docx

# Security and audit files
SECURITY_AUDIT_REPORT.md
DELETED_FILES_IMPACT.md
FINAL_SECURITY_VERIFICATION.md
PRIVACY_UPDATE_COMPLETE.md

# Unnecessary documentation files
ADMIN_AUTH_COMPLETE.md
CATEGORY_FIX.md
CHATBOT_TEST_RESULTS.md
PRODUCTS_CLEANUP_COMPLETE.md
GITHUB_PUSH_CHECKLIST.md
PUSH_TO_GITHUB_SUMMARY.md
FINAL_PUSH_INSTRUCTION.md
PUSH_COMMANDS.txt
GITHUB_REPO_DESCRIPTION.txt
CLEANUP_COMPLETE.txt
RUN.md

# Temporary files created during development
CleanDuplicates.java
clean_duplicates.ps1
remove_duplicate_products.sql

# Python report generation scripts
build_*.py
generate_*.py
edit_report.py
create_from_template.py
quick_report.py

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS files
.DS_Store
Thumbs.db

# Build outputs
target/
dist/
build/
*.jar
*.war

# Dependencies
node_modules/

# Logs
*.log
logs/

# Compiled files
*.class
*.pyc

# Personal notes (if any)
**/notes/
**/personal/
